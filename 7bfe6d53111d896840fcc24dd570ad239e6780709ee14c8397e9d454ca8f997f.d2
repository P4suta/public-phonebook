vars: {
  d2-config: {
    layout-engine: elk
    pad: 40
    theme-overrides: {
      N1: "#000000"
      N2: "#000000"
      N3: "#000000"
      N4: "#FFFFFF"
      N5: "#FFFFFF"
      N6: "#FFFFFF"
      N7: "#FFFFFF"
      B1: "#000000"
      B2: "#000000"
      B3: "#FFFFFF"
      B4: "#FFFFFF"
      B5: "#FFFFFF"
      B6: "#FFFFFF"
      AA2: "#000000"
      AA4: "#FFFFFF"
      AA5: "#FFFFFF"
      AB4: "#FFFFFF"
      AB5: "#FFFFFF"
    }
  }
}

direction: right

proof: Delivery proof {
  source: "Staged Cargo crate\nsrc/lib.rs"
  checks: "Production Kani proofs"
  control: "Planted missing-evidence defect"
  rejection: "Required counterexample"
  source -> checks -> control -> rejection
}

native: Native verification {
  model: "Requested device type"
  platform: "CoreSimulator"
  device: "Checkout-owned device\nCompatible installed runtime"
  tests: "Native UI checks\nObserved runtime in results"
  model -> platform -> device -> tests
}
