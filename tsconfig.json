{
  "compilerOptions": {
    "target": "ES2023",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client", "@cloudflare/workers-types"],
    "jsx": "react-jsx",
    "skipLibCheck": true
  },
  "include": [
    "apps/web/src/**/*.ts",
    "apps/web/src/**/*.tsx",
    "apps/web/*.ts",
    "packages/**/*.ts",
    "data/**/*.ts",
    "infrastructure/**/*.ts",
    "tools/**/*.ts",
    "tests/unit/**/*.ts",
    "tests/unit/**/*.tsx",
    "apps/web/tests/browser/**/*.ts",
    "*.ts"
  ]
}
