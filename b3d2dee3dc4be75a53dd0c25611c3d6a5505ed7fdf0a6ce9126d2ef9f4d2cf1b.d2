vars: {
  d2-config: {
    layout-engine: elk
    pad: 40
    theme-overrides: {
      N1: "#000000"
      N2: "#000000"
      N3: "#000000"
      N4: "#FFFFFF"
      N5: "#FFFFFF"
      N6: "#FFFFFF"
      N7: "#FFFFFF"
      B1: "#000000"
      B2: "#000000"
      B3: "#FFFFFF"
      B4: "#FFFFFF"
      B5: "#FFFFFF"
      B6: "#FFFFFF"
      AA2: "#000000"
      AA4: "#FFFFFF"
      AA5: "#FFFFFF"
      AB4: "#FFFFFF"
      AB5: "#FFFFFF"
    }
  }
}

direction: down

image: "GitHub Xcode runner image"
runtimes: "Installed iOS and watchOS runtimes"
selection: "CoreSimulator\nCompatible runtime for the requested model"
checks: "Phone, Duo, iPad, and paired Watch checks"

image -> runtimes: supplied by GitHub
runtimes -> selection: installed runtime inventory
selection -> checks: checkout-owned devices
