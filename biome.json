{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "apps/web/**",
      "packages/**",
      "tools/**",
      "data/src/**",
      "data/package.json",
      "infrastructure/cloudflare/**",
      "releases/**",
      "docs/*.json",
      "tests/**",
      "*.ts",
      "tsconfig.json",
      "package.json",
      "biome.json",
      "*.json",
      "!!apps/web/src/routeTree.gen.ts",
      "!!tools/ios-check/target/**",
      "!!tools/android-check/target/**",
      "!!tools/delivery/target/**"
    ]
  },
  "formatter": { "indentStyle": "space" },
  "linter": {
    "enabled": true,
    "rules": { "preset": "none", "suspicious": { "noExplicitAny": "error" } }
  }
}
