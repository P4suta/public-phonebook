{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "files": {
    "includes": [
      "src/**",
      "tools/**",
      "docs/*.json",
      "tests/**",
      "web/**",
      "cloudflare/**/*.ts",
      "cloudflare/*.json",
      "cloudflare.config.ts",
      "vite.config.ts",
      "*.ts",
      "tsconfig.json",
      "package.json",
      "biome.json",
      "*.json",
      "!!src/routeTree.gen.ts"
    ]
  },
  "formatter": { "indentStyle": "space" },
  "linter": {
    "enabled": true,
    "rules": { "preset": "none", "suspicious": { "noExplicitAny": "error" } }
  }
}
