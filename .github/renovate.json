{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>P4suta/renovate-config"],
  "ignoreDeps": ["xlsx"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^package\\.json$/"],
      "matchStrings": [
        "\"xlsx\": \"https://cdn\\.sheetjs\\.com/xlsx-(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)/xlsx-[0-9]+\\.[0-9]+\\.[0-9]+\\.tgz\""
      ],
      "depNameTemplate": "sheetjs",
      "packageNameTemplate": "https://git.sheetjs.com/SheetJS/sheetjs.git",
      "datasourceTemplate": "git-tags",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "autoReplaceStringTemplate": "\"xlsx\": \"https://cdn.sheetjs.com/xlsx-{{{newValue}}}/xlsx-{{{newValue}}}.tgz\""
    }
  ],
  "packageRules": [
    {
      "matchFileNames": ["proof/**", "verification/**"],
      "matchDatasources": ["deb"],
      "registryUrls": [
        "https://deb.debian.org/debian?suite=bookworm&components=main&binaryArch=amd64",
        "https://deb.debian.org/debian?suite=bookworm-updates&components=main&binaryArch=amd64",
        "https://security.debian.org/debian-security?suite=bookworm-security&components=main&binaryArch=amd64"
      ]
    },
    {
      "matchFileNames": ["verification/linux/**"],
      "matchDatasources": ["deb"],
      "registryUrls": [
        "https://ports.ubuntu.com/ubuntu-ports?suite=noble&components=main,universe&binaryArch=arm64",
        "https://ports.ubuntu.com/ubuntu-ports?suite=noble-updates&components=main,universe&binaryArch=arm64",
        "https://ports.ubuntu.com/ubuntu-ports?suite=noble-security&components=main,universe&binaryArch=arm64"
      ]
    }
  ]
}
