{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": true,
  "skip-github-release": true,
  "packages": {
    ".": {
      "release-type": "simple",
      "component": "ios",
      "include-component-in-tag": true,
      "version-file": "apps/ios/version.txt",
      "changelog-path": "apps/ios/CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "apps/ios/AppStore/metadata.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
