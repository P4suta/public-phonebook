from enum import Enum

class SplitMode(Enum):
    A = "A"
    B = "B"
    C = "C"

class Morpheme:
    def surface(self) -> str: ...
    def reading_form(self) -> str: ...
    def is_oov(self) -> bool: ...

class Tokenizer:
    def tokenize(self, text: str) -> list[Morpheme]: ...

class Dictionary:
    def __init__(self, *, dict: str) -> None: ...
    def tokenizer(self, mode: SplitMode) -> Tokenizer: ...
    def lookup(self, text: str) -> list[Morpheme]: ...
    def close(self) -> None: ...
