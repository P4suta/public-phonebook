{
  "name": "public-phonebook",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cf dev",
    "preview": "vite preview --mode development --host 127.0.0.1 --port 8787 --strictPort",
    "build": "node tools/build.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tests/public/tsconfig.json",
    "lint": "biome check src tools tests/unit tests/browser tests/public docs/*.json *.ts *.json && oxlint --type-aware --deny-warnings src tools tests/unit tests/browser tests/public *.ts",
    "test": "vitest run",
    "e2e": "playwright test",
    "browsers": "playwright install chromium firefox webkit",
    "data": "node tools/data.ts",
    "data:local": "node tools/local-data.ts",
    "data:check": "node tools/check-data.ts",
    "data:phones": "node tools/phone-quality.ts",
    "check": "node tools/check.ts",
    "prove": "node tools/prove.ts",
    "audit": "npm audit --audit-level=moderate",
    "data:remote": "node tools/remote-data.ts",
    "publish": "node tools/publish.ts"
  },
  "dependencies": {
