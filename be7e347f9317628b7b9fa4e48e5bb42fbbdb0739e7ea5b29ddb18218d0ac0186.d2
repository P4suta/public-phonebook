vars: {
  d2-config: {
    layout-engine: elk
    pad: 40
    theme-overrides: {
      N1: "#000000"
      N2: "#000000"
      N3: "#000000"
      N4: "#FFFFFF"
      N5: "#FFFFFF"
      N6: "#FFFFFF"
      N7: "#FFFFFF"
      B1: "#000000"
      B2: "#000000"
      B3: "#FFFFFF"
      B4: "#FFFFFF"
      B5: "#FFFFFF"
      B6: "#FFFFFF"
      AA2: "#000000"
      AA4: "#FFFFFF"
      AA5: "#FFFFFF"
      AB4: "#FFFFFF"
      AB5: "#FFFFFF"
    }
  }
}

direction: down
watch: "Apple Watch\nNative search and facility details"
session: "Watch Connectivity\nBounded requests and replies"
phone: "Paired iPhone\nSearch the saved directory generation"
watch -> session: Send a query and request identifier
session -> phone: Deliver the active request
phone -> session: Return up to ten facilities and their sources
session -> watch: Show replies for the current request
